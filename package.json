{
  "name": "minimi-chat-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Chat agent with web search and time-aware memory (Groq + Tavily free tiers)",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "tsx --env-file-if-exists=.env src/server.ts",
    "seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "seed:fixtures": "tsx --env-file-if-exists=.env scripts/seed-fixtures.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "ask": "tsx --env-file-if-exists=.env scripts/ask.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "chrono-node": "^2.10.3",
    "hono": "^4.13.17",
    "openai": "^7.55.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
